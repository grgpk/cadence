@baseUrl = http://localhost:3001
@slug = cadence-host
@type = coaching
@eventTypeUnid = e1000000-0000-4000-8000-000000000001
# The unid returned by "Add a webhook".
@webhookUnid = replace-with-a-webhook-unid
@leadUnid = 00000000-0000-0000-0000-000000000001
@bookingUnid = 00000000-0000-0000-0000-000000000002
# The manage_token returned by "Book call".
@manageToken = replace-with-a-manage-token

### Health
GET {{baseUrl}}/health

### Register host
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{"email":"host@example.com","password":"password123","full_name":"Cadence Host"}

### Login host
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{"email":"host@example.com","password":"password123"}

### Current session
GET {{baseUrl}}/api/auth/me

### Plans and prices (public)
GET {{baseUrl}}/api/billing/plans

### My plan, trial and bookings this month
GET {{baseUrl}}/api/billing/me

### Stripe Checkout for a paid plan (503 without Stripe keys, 409 when already paying)
POST {{baseUrl}}/api/billing/checkout
Content-Type: application/json

{"plan":"pro","interval":"year"}

### Stripe Customer Portal (409 before the first payment)
POST {{baseUrl}}/api/billing/portal

### Change my name
PUT {{baseUrl}}/api/auth/me
Content-Type: application/json

{"full_name":"Cadence Host"}

### Change my password (400 when the current one is wrong)
POST {{baseUrl}}/api/auth/password
Content-Type: application/json

{"current_password":"password123","new_password":"password456"}

### Forgot password (always 200; queues a real email for a known address)
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{"email":"host@example.com"}

### Reset password with the token from the emailed link
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{"token":"replace-with-the-token-from-the-email","password":"password456"}

### Availability
GET {{baseUrl}}/api/availability

### Create availability rule
POST {{baseUrl}}/api/availability
Content-Type: application/json

{"weekday":1,"start_time":"09:00:00","end_time":"17:00:00","slot_minutes":30}

### Update availability rule
PUT {{baseUrl}}/api/availability/1
Content-Type: application/json

{"weekday":1,"start_time":"10:00:00","end_time":"16:00:00","slot_minutes":30}

### Delete availability rule
DELETE {{baseUrl}}/api/availability/1

### Dates with their own hours, from yesterday on
GET {{baseUrl}}/api/availability/overrides

### Take a date off (no ranges)
PUT {{baseUrl}}/api/availability/overrides/2026-10-24
Content-Type: application/json

{"ranges":[]}

### Give a date other hours
PUT {{baseUrl}}/api/availability/overrides/2026-10-28
Content-Type: application/json

{"ranges":[{"start_time":"10:00:00","end_time":"13:00:00","slot_minutes":30}]}

### Put a date back on the weekly hours
DELETE {{baseUrl}}/api/availability/overrides/2026-10-24

### My booking page settings (creates the link and a first event type on first read)
GET {{baseUrl}}/api/host/settings

### Update my booking page settings
PUT {{baseUrl}}/api/host/settings
Content-Type: application/json

{"public_slug":"cadence-host","timezone":"Europe/Paris","meeting_link":null,"conferencing_app":"google_meet","is_active":true}

### My event types (bookable is false past my plan)
GET {{baseUrl}}/api/host/event-types

### New event type (403 past my plan, 409 when the link is taken)
POST {{baseUrl}}/api/host/event-types
Content-Type: application/json

{"slug":"deep-dive-2","title":"Deep dive","description":"","duration_minutes":60,"buffer_minutes":15,"minimum_notice_hours":24,"booking_window_days":14,"questions":[],"is_active":true}

### Update an event type (duration_minutes null follows the hours)
PUT {{baseUrl}}/api/host/event-types/{{eventTypeUnid}}
Content-Type: application/json

{"slug":"coaching","title":"Book a coaching call","description":"","duration_minutes":null,"buffer_minutes":15,"minimum_notice_hours":4,"booking_window_days":7,"questions":[],"is_active":true}

### Delete an event type (409 for the last one)
DELETE {{baseUrl}}/api/host/event-types/{{eventTypeUnid}}

### Where my calls happen (google_meet or custom_link; custom_link needs the link)
PUT {{baseUrl}}/api/host/conferencing
Content-Type: application/json

{"app":"custom_link","meeting_link":"https://zoom.us/j/123456789"}

### Public link: the host and the event types it offers
GET {{baseUrl}}/api/hosts/{{slug}}

### One event type's page (accepting_bookings is false while paused or past the plan)
GET {{baseUrl}}/api/hosts/{{slug}}/types/{{type}}

### Public slots of an event type
GET {{baseUrl}}/api/hosts/{{slug}}/types/{{type}}/slots

### Create/update lead
POST {{baseUrl}}/api/hosts/{{slug}}/types/{{type}}/leads/{{leadUnid}}
Content-Type: application/json

{"first_name":"Ada","last_name":"Lovelace","email":"ada@example.com","answers":[{"question":"urgency_level","answer":"7-8 (High priority)"}]}

### Track widget visit
POST {{baseUrl}}/api/calling-visits
Content-Type: application/json

{"source_page":"/","utm_source":"request-http","user_agent":"HTTP Client"}

### Book call
# slot_start must be one of the starts returned by the slots request above.
POST {{baseUrl}}/api/hosts/{{slug}}/types/{{type}}/bookings
Content-Type: application/json

{"lead_unid":"{{leadUnid}}","slot_start":"2026-10-12T07:00:00Z","timezone":"Europe/Paris","invitee_name":"Ada Lovelace","invitee_email":"ada@example.com"}

### My webhooks (secrets included; Business only)
GET {{baseUrl}}/api/host/webhooks

### Add a webhook (400 for a URL that is not public https, 409 past five)
POST {{baseUrl}}/api/host/webhooks
Content-Type: application/json

{"url":"https://example.com/hooks/cadence"}

### Switch a webhook off (turning it on needs Business)
PUT {{baseUrl}}/api/host/webhooks/{{webhookUnid}}
Content-Type: application/json

{"is_active":false}

### Send a test ping to a webhook
POST {{baseUrl}}/api/host/webhooks/{{webhookUnid}}/test

### A webhook's last 20 deliveries
GET {{baseUrl}}/api/host/webhooks/{{webhookUnid}}/deliveries

### Delete a webhook
DELETE {{baseUrl}}/api/host/webhooks/{{webhookUnid}}

### Invitee: my call, through the manage link
GET {{baseUrl}}/api/manage/{{manageToken}}

### Invitee: move my call to another open time
POST {{baseUrl}}/api/manage/{{manageToken}}/reschedule
Content-Type: application/json

{"slot_start":"2026-10-13T07:00:00Z"}

### Invitee: cancel my call
POST {{baseUrl}}/api/manage/{{manageToken}}/cancel

### My bookings
GET {{baseUrl}}/api/bookings

### One of my bookings, with the invitee's answers
GET {{baseUrl}}/api/bookings/{{bookingUnid}}

### Cancel one of my bookings
POST {{baseUrl}}/api/bookings/{{bookingUnid}}/cancel

### Start connecting Google Calendar (returns client_id, redirect_uri and a one-time state for the Google URL)
GET {{baseUrl}}/api/google-calendar/oauth-config

### Finish connecting Google Calendar (400 unless state is the one Google sent back, unused and under 10 minutes old)
POST {{baseUrl}}/api/google-calendar/login
Content-Type: application/json

{"code":"replace-with-the-code-from-google","state":"replace-with-the-state-from-google"}

### Admin leads
GET {{baseUrl}}/api/admin/leads

### Admin bookings
GET {{baseUrl}}/api/admin/bookings

### Admin bug reports
GET {{baseUrl}}/api/admin/bug-reports

### Public bug report
POST {{baseUrl}}/api/bug-reports
Content-Type: application/json

{"bug_type":"Bug","message":"Widget test report","user_login":"request-http","stack_trace":null}

### Admin role accesses
GET {{baseUrl}}/api/admin/roleaccesses

### Admin hosts
GET {{baseUrl}}/api/admin/hosts

### Admin emails
GET {{baseUrl}}/api/admin/emails

### Admin visit funnel, last 7 days
GET {{baseUrl}}/api/admin/calling-visits/funnel

### Logout
POST {{baseUrl}}/api/auth/logout

### Admin: every host's plan
GET {{baseUrl}}/api/admin/billing

### Admin: give a host Business for free (null takes a comped plan back)
PUT {{baseUrl}}/api/admin/billing/00000000-0000-4000-8000-100000000003
Content-Type: application/json

{"plan":"business"}
