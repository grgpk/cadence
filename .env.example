# Backend
# Database. Keep POSTGRES_* aligned with local Postgres or docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=cadence
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1/${POSTGRES_DATABASE}
JWT_SECRET=replace-with-a-long-random-secret
# `local` is the only value that sends the session cookie over plain HTTP.
# Any other value, or none, marks it Secure.
APP_ENV=local
CORS_ORIGINS=http://localhost:3000
# Public site URL used for links in emails, no trailing slash. Optional:
# falls back to the first CORS_ORIGINS entry.
APP_URL=http://localhost:3000

# Resend SMTP
EMAIL_FROM=put-your-email-here@example.com
RESEND_API_KEY=re_xxx
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=587
RESEND_SMTP_USERNAME=resend

# Stripe billing. Leave empty to run without payments: checkout and the
# portal answer 503. Test-mode keys locally; the webhook secret comes from
# `stripe listen --forward-to localhost:3001/api/billing/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/dashboard/calendar/callback

# Frontend
VITE_API_URL=http://localhost:3001
