# Backend
# Database. Keep POSTGRES_* aligned with local Postgres or docker-compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=cadence
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1/${POSTGRES_DATABASE}
JWT_SECRET=replace-with-a-long-random-secret
APP_ENV=local
CORS_ORIGINS=http://localhost:3000

# Resend SMTP
EMAIL_FROM=put-your-email-here@example.com
RESEND_API_KEY=re_xxx
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=587
RESEND_SMTP_USERNAME=resend

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/admin/google-oauth-callback

# Frontend
VITE_API_URL=http://localhost:3001
