# Copy to .env.prod, fill values, then run:
# ./__setup_prod_server_env.sh

DOCKER_USERNAME=replace-with-dockerhub-username
DOCKER_REPOSITORY=cadence

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DATABASE=cadence
DATABASE_URL=postgres://postgres:replace-with-long-random-password@db:5432/cadence

JWT_SECRET=replace-with-long-random-secret
APP_ENV=production
ENVIRONMENT=production
CORS_ORIGINS=https://bookcadence.app
# Public site URL used for links in emails, no trailing slash. Optional:
# falls back to the first CORS_ORIGINS entry.
APP_URL=https://bookcadence.app

# Resend SMTP credentials. API key acts as SMTP password.
EMAIL_FROM=Cadence <verified-sender@example.com>
RESEND_API_KEY=re_xxx
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=587
RESEND_SMTP_USERNAME=resend

# Stripe billing. Leave empty to run without payments: checkout and the
# portal answer 503. Test-mode keys locally; the webhook secret comes from
# `stripe listen --forward-to localhost:3001/api/billing/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=

# Google Calendar OAuth client.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://bookcadence.app/dashboard/calendar/callback
